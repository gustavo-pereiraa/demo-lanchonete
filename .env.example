# Chave usada pelo Flask para assinar a sessão do painel.
# Gere uma própria antes de publicar o site, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Administrador criado pelo comando "flask --app app.py seed" (apenas na primeira vez)
ADMIN_NAME=Dona da Lanchonete
ADMIN_EMAIL=dona@lanchonete.com
ADMIN_PASSWORD=lanchonete123

# Taxa de entrega cobrada em pedidos do tipo "entrega". Definida só aqui —
# o formulário do cliente nunca pode alterar esse valor.
DELIVERY_FEE=5.00

# Por padrão o sistema usa SQLite (arquivo local, zero configuração).
# Para usar outro banco (ex: PostgreSQL ou MySQL), descomente e ajuste:
# DATABASE_URL=postgresql://usuario:senha@localhost/lanchonete
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost/lanchonete

# ---------------------------------------------------------------------
# Produção (quando for hospedar de verdade, fora do seu computador)
# ---------------------------------------------------------------------
# FLASK_DEBUG=true liga o modo de desenvolvimento (debug do Flask, cookie
# sem HTTPS, sem HSTS). Só vale no seu computador: se a variável estiver
# AUSENTE, o sistema assume produção e mantém todas as proteções ligadas.
# No Render (variável RENDER definida automaticamente) é sempre produção,
# mesmo que FLASK_DEBUG=true seja cadastrado por engano. Mesmo assim,
# cadastre FLASK_DEBUG=false no painel do Render para deixar explícito.
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000
